# Copier ce fichier vers /etc/ris-pro/env (droits 600, propriétaire root) puis remplir les valeurs.
# Ne jamais committer le fichier rempli.
RIS_DOMAIN=
# internal = certificat provisoire pour tester avant la bascule du DNS. Laisser vide en production.
RIS_TLS=internal
NEXT_PUBLIC_SITE_URL=
PORT=3000
HOST=127.0.0.1

# Base de données (Neon)
DATABASE_URL=


# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails transactionnels : Brevo (clé d'API v3). L'expéditeur doit être sur le domaine authentifié
# ris.hologramconseils.com ; les réponses des clients vont à MAIL_REPLY_TO.
BREVO_API_KEY=
MAIL_FROM_EMAIL=ris@ris.hologramconseils.com
MAIL_FROM_NAME="RIS Pro"
MAIL_REPLY_TO=bertrand.saulnerond@hologramconseils.com

# Stockage des PDF : OVHcloud Object Storage (API S3, région Gravelines), conteneur privé
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
OVH_S3_BUCKET=ris-pro-releves
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=

# Sauvegardes chiffrées de la base : conteneur OVHcloud PRIVÉ (ici celui des relevés, dossier « db/ »).
# Laisser les deux clés ci-dessous vides pour réutiliser OVH_S3_ACCESS_KEY / OVH_S3_SECRET_KEY.
OVH_BACKUP_BUCKET=ris-pro-releves
OVH_BACKUP_ACCESS_KEY=
OVH_BACKUP_SECRET_KEY=

# Anciens relevés (avant la migration) : encore stockés sur Vercel Blob, utilisé seulement pour
# les supprimer à l'échéance de 6 mois. Peut être retiré une fois ces fichiers purgés.
BLOB_READ_WRITE_TOKEN=

# Analyse (Mistral)
MISTRAL_API_KEY=

# Sécurité
NIR_SALT=
CRON_SECRET=
