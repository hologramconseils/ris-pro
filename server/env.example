# Copier ce fichier vers /etc/ris-pro/env (droits 600, propriétaire root) puis remplir les valeurs.
# Ne jamais committer le fichier rempli.
RIS_DOMAIN=
NEXT_PUBLIC_SITE_URL=
PORT=3000
HOST=127.0.0.1

# Base de données (Neon)
DATABASE_URL=

# Authentification (Clerk)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend)
RESEND_API_KEY=

# Stockage des PDF (Vercel Blob, utilisable depuis n'importe quel serveur)
BLOB_READ_WRITE_TOKEN=

# Analyse (Mistral)
MISTRAL_API_KEY=

# Sécurité
NIR_SALT=
CRON_SECRET=
