# Copier ce fichier vers /etc/ris-pro/env (droits 600, propriétaire root) puis remplir les valeurs.
# Ne jamais committer le fichier rempli.
RIS_DOMAIN=
# internal = certificat provisoire pour tester avant la bascule du DNS. Laisser vide en production.
RIS_TLS=internal
NEXT_PUBLIC_SITE_URL=
PORT=3000
HOST=127.0.0.1

# Base de données (Neon)
DATABASE_URL=

# Authentification (Clerk)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend)
RESEND_API_KEY=

# Stockage des PDF : OVHcloud Object Storage (API S3, région Gravelines), conteneur privé
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
OVH_S3_BUCKET=ris-pro-releves
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=

# Anciens relevés (avant la migration) : encore stockés sur Vercel Blob, utilisé seulement pour
# les supprimer à l'échéance de 6 mois. Peut être retiré une fois ces fichiers purgés.
BLOB_READ_WRITE_TOKEN=

# Analyse (Mistral)
MISTRAL_API_KEY=

# Sécurité
NIR_SALT=
CRON_SECRET=
